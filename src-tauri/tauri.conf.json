{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todo Sticky",
  "version": "0.1.1",
  "identifier": "com.agicodex.daibanshixiang",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Todo Sticky",
        "width": 380,
        "height": 640,
        "minWidth": 330,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "both"
      }
    }
  }
}
